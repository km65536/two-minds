# ===== TWO MINDS 設定 =====
# このファイルを .env にコピーして使います（.env は Git にコミットされません）。
# Render では、ダッシュボードの Environment に同じ名前で設定してください。

# Gemini API キー（必須：AI 会話に使用）
# Google AI Studio（https://aistudio.google.com/apikey）で発行します。
# 課金されないよう、請求先（Billing）を設定していないプロジェクトのキーを使ってください。
GEMINI_API_KEY=

# 使用するモデル（無料枠のあるモデルを指定）
GEMINI_MODEL=gemini-3.5-flash-lite

# 1 回の生成（会話記録 1 つ・最大 36 発言）の最大出力トークン数（思考トークンも含む）
GEMINI_MAX_OUTPUT_TOKENS=8192

# 思考の深さ（MINIMAL / LOW / MEDIUM / HIGH）。空欄ならモデルの既定値を使う
# モデルによって受け付ける値が違うので、変えるときは公式ドキュメントで確認してください
GEMINI_THINKING_LEVEL=

# 出力形式の指定方法。schema = 簡略化した JSON Schema を送る（既定）
# json = スキーマを送らず JSON 出力だけを指定する（Gemini がスキーマを拒否するときの回避策）
GEMINI_SCHEMA_MODE=schema

# AI 会話の有効/無効（false にするとデモモードのみで動作。緊急停止用）
AI_ENABLED=true

# ---- 使いすぎ・不正利用の防止（Gemini の無料枠より低く設定してください） ----
# サイト全体での 1 日（太平洋時間）あたりの API 呼び出し上限
DAILY_CALL_LIMIT=300
# サイト全体での 1 分あたりの API 呼び出し上限
RPM_LIMIT=10
# 接続元 IP ごとの 1 日あたり / 1 分あたりの上限
IP_DAILY_LIMIT=120
IP_RPM_LIMIT=8
# 接続元 IP ごとの、発言リクエストの最小間隔（ミリ秒）
IP_MIN_INTERVAL_MS=2500
# 同時に処理する AI リクエスト数
MAX_CONCURRENT=3

# ---- Gemini が一時的に不安定なとき（503 過負荷・分間上限の 429・タイムアウト） ----
# 1 回の呼び出しの制限時間（ミリ秒）
GEMINI_TIMEOUT_MS=60000
# 失敗したあと、サーバー全体で Gemini を呼ばずに待つ時間の初期値と上限（ミリ秒）。失敗が続くと倍々に伸びる
UPSTREAM_COOLDOWN_BASE_MS=4000
UPSTREAM_COOLDOWN_MAX_MS=60000

# サーバーのポート / バインドアドレス（Render では自動設定されるので不要）
PORT=3000
HOST=127.0.0.1
