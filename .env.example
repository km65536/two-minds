# ===== TWO MINDS 設定 =====
# Anthropic API キー（必須：実際のAI会話に使用）
# https://console.anthropic.com/ で発行してください。
# このファイルを .env にコピーして値を設定します。.env は Git にコミットされません。
ANTHROPIC_API_KEY=

# 使用するモデル（省略時: claude-opus-5-5）
ANTHROPIC_MODEL=claude-opus-5-5

# 記憶の抽出に使うモデル（省略時: ANTHROPIC_MODEL と同じ）
# MEMORY_MODEL=claude-opus-5-5

# 推論の深さ（low / medium / high / xhigh / max）
# 会話は軽めの low、記憶整理は medium を推奨
CONVERSATION_EFFORT=low
MEMORY_EFFORT=medium

# 安全性分類器が応答を拒否した場合、サーバー側で推奨モデルに自動フォールバックする（on / off）
ANTHROPIC_FALLBACKS=on

# 1時間あたりの API 呼び出し上限（使いすぎ防止）
MAX_CALLS_PER_HOUR=400

# サーバーのポート / バインドアドレス
PORT=3000
HOST=127.0.0.1
